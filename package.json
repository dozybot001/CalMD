{
  "name": "calmd",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, distraction-free Markdown reader in your browser.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.6.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
